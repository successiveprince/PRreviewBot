# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit real secrets. In GitHub Actions, these are
# provided instead via the action's inputs/secrets (see action.yml) and always
# take precedence over anything in .env.

# A GitHub personal access token (repo scope) - used to read PR diffs/content and post reviews.
GITHUB_TOKEN=

# API key from https://openrouter.ai/ - used to generate review comments.
OPENROUTER_API_KEY=

# Optional: override the default ":free" model used for review generation.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: lets you omit --owner/--repo when running the CLI locally (format "owner/repo").
GITHUB_REPOSITORY=
